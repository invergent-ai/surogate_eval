##### Detailed Results ({{ bench.detailed_results | length }} test cases)

{% set results_by_type = {} %}
{% for detail in bench.detailed_results %}
{% set eval_type = detail.eval_type | default('unknown') %}
{% if eval_type not in results_by_type %}
{% set _ = results_by_type.update({eval_type: []}) %}
{% endif %}
{% set _ = results_by_type[eval_type].append(detail) %}
{% endfor %}

{% for eval_type, type_results in results_by_type.items() %}
{#- A row we could not measure is neither a pass nor a fail. Counting it as
    failed reads as "the model got this wrong" for a row nobody scored.
    `status` is absent on rows from backends that never error a single row
    (lm_eval's direct results carry neither `status` nor `success`), so
    "no status" has to mean scored, or those benchmarks change silently. -#}
{% set unmeasured_cases = type_results | selectattr('status', 'defined') | selectattr('status', 'equalto', 'errored') | list %}
{% set scored_cases = type_results | rejectattr('status', 'defined') | list + (type_results | selectattr('status', 'defined') | rejectattr('status', 'equalto', 'errored') | list) %}
{% set passed = scored_cases | selectattr('success') | list | length %}
{% set failed = scored_cases | length - passed %}

###### {{ eval_type | replace('_', ' ') | title }} ({{ type_results | length }} cases)

**Summary:** ✅ {{ passed }} passed, ❌ {{ failed }} failed{% if unmeasured_cases %}, ⚠️ {{ unmeasured_cases | length }} not measured{% endif %}

| # | Instruction | Expected | Output | Score | Status | Reason |
|---|-------------|----------|--------|-------|--------|--------|
{% for detail in type_results %}
| {{ detail.original_idx | default('?') }} | {{ detail.instruction | default('') | truncate(50) | replace('\n', ' ') | replace('|', '\\|') }} | `{{ detail.expected | default('') | truncate(20) | replace('\n', ' ') | replace('|', '\\|') }}` | `{{ detail.output | default('') | truncate(20) | replace('\n', ' ') | replace('|', '\\|') }}` | {{ detail.score | format_score(2) if detail.score is number else 'not measured' }} | {{ "⚠️" if detail.status is defined and detail.status == 'errored' else ("✅" if detail.success else "❌") }} | {{ detail.reason | default('') | truncate(40) | replace('\n', ' ') | replace('|', '\\|') }} |
{% endfor %}

